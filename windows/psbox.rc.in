// SPDX-License-Identifier: GPL-3.0-or-later
// psbox.exe's resources: its icon, its manifest (windows/psbox.manifest) and
// the version shown in Explorer's Properties. Configured by CMake.
#include <winver.h>

1 ICON "@XC_WIN_DIR@/psbox.ico"
1 24 "@XC_WIN_DIR@/psbox.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "PSBox Cloud Gaming"
            VALUE "ProductName", "PSBox Cloud Gaming"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "psbox"
            VALUE "OriginalFilename", "psbox.exe"
            VALUE "LegalCopyright", "GPL-3.0-or-later. Unofficial; not affiliated with Microsoft or Sony."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
